{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "package.json",
      "tsconfig.json",
      "biome.json",
      "vitest.config.ts",
      "packages/**",
      "!**/dist",
      "!**/node_modules"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double" } }
}
