{
  "name": "coldfront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p packages/shared/tsconfig.test.json --noEmit && biome check .",
    "build": "npm run build --workspace @coldfront/shared",
    "noise:calibrate": "tsx packages/shared/test/calibrate-quantiles.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.19.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
